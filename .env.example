# Copy this file to .env and fill in your values.
# OPENAI_API_KEY required for `ask` (works with any OpenAI-compatible API).
OPENAI_API_KEY=
# Optional: set for a non-OpenAI compatible endpoint (e.g. a local vLLM server).
OPENAI_BASE_URL=
# Optional: override the LLM model name used for answers.
RAG_LLM_MODEL=
# Optional server settings (defaults shown):
# QYD_PORT=8000
# QYD_HOST=127.0.0.1
# QYD_DOCS_DIR=data/docs
# QYD_HISTORY_DB=data/history.db
# RAG_DB=data/kb.db
# RAG_MODEL_DIR=models/intfloat/multilingual-e5-small/onnx
